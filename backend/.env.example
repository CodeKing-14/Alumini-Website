# Backend Environment Variables Example Template
# Copy this file to .env and fill in your values

DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/alumni_db
JWT_SECRET=your-random-jwt-secret-key-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email SMTP Configuration (Gmail 16-character App Password)
SMTP_USER=sritalumni@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ADMIN_VERIFICATION_EMAIL=sritalumni@gmail.com
SITE_URL=http://localhost:8000

# Seed login accounts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
STUDENT_EMAIL=student@example.com
STUDENT_PASSWORD=Student@12345
